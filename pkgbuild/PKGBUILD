pkgname=o-rdp
pkgver=0.1.0
pkgrel=1
pkgdesc='Find the PCs with Remote Desktop on your network and connect to them'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'freerdp')
optdepends=('libsecret: remember passwords in the keyring (secret-tool)'
            'avahi: names for PCs that answer neither NetBIOS nor DNS')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/o-rdp "$pkgdir/usr/bin/o-rdp"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/o-rdp.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/o-rdp.svg"
  install -Dm644 "$startdir/o-rdp.desktop" "$pkgdir/usr/share/applications/o-rdp.desktop"
}
